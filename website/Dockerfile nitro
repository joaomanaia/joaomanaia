FROM oven/bun:1-alpine AS base

# Build stage
FROM base AS builder

WORKDIR /app

# Copy package files
COPY package.json bun.lock* ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy source code
COPY . .

# Build the application
RUN bun run build

# Production stage
FROM base AS runner

WORKDIR /app

ENV NODE_ENV=production

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs bunjs

# Copy built output from builder
COPY --from=builder --chown=bunjs:nodejs /app/.output ./.output
COPY --from=builder --chown=bunjs:nodejs /app/package.json ./package.json

# Switch to non-root user
USER bunjs

# Expose the port
EXPOSE 3000/tcp

# Start the application
CMD ["bun", "run", "--bun", ".output/server/index.mjs"]
