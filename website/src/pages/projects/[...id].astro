---
import { getCollection, render, getEntries } from "astro:content"
import Layout from "../../layouts/Layout.astro"
import { Badge } from "../../components/ui/badge"
import { ExternalLinkIcon } from "lucide-react"
import { buttonVariants } from "@/components/ui/button"
import { Separator } from "@/components/ui/separator"

export async function getStaticPaths() {
  const projects = await getCollection("projects")
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await render(project)
const hasContent = (project.body ?? "").trim().length > 0
const relatedProjects = project.data.related ? await getEntries(project.data.related) : []
---

<Layout title={project.data.title} description={project.data.description}>
  <main class="relative grow">
    <header class="container mx-auto max-w-4xl px-6 pt-16 pb-12 md:pt-24 lg:pt-32 xl:pt-40">
      <h1 class="text-foreground mb-4 text-center font-mono text-4xl font-bold md:text-5xl">
        {project.data.title}
      </h1>

      <p class="text-muted-foreground text-center text-xl leading-relaxed">
        {project.data.description}
      </p>

      <div class="mt-6 mb-4 flex flex-wrap justify-center gap-2">
        {project.data.tags.map((tag) => <Badge variant="secondary">{tag}</Badge>)}
      </div>

      <div class="mt-6 flex flex-wrap justify-center gap-4">
        {
          project.data.links.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class={buttonVariants({ variant: link.variant })}
            >
              <ExternalLinkIcon />
              {link.name}
            </a>
          ))
        }
      </div>
    </header>

    {
      hasContent && (
        <>
          <Separator />
          <div class="prose dark:prose-invert prose-pre:bg-muted/50 container mx-auto max-w-4xl px-6 py-12">
            <Content />
          </div>
        </>
      )
    }
    {
      relatedProjects.length > 0 && (
        <>
          <Separator />
          <div class="not-prose container mx-auto max-w-4xl px-6 py-12">
            <h2 class="text-foreground mb-8 flex items-center gap-2 font-mono text-2xl font-bold">
              Related Projects
            </h2>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              {relatedProjects.map((related) => (
                <a
                  href={`/projects/${related.id}`}
                  class="group border-border bg-card hover:border-muted-foreground hover:bg-accent flex flex-col rounded-xl border p-5 transition-all duration-300"
                >
                  <div class="mb-2 flex items-center justify-between">
                    <h3 class="text-card-foreground group-hover:text-accent-foreground font-mono text-lg font-semibold">
                      {related.data.title}
                    </h3>
                  </div>
                  <p class="text-muted-foreground line-clamp-2 text-sm leading-relaxed italic">
                    {related.data.description}
                  </p>
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {related.data.tags.slice(0, 3).map((t) => (
                      <span class="text-muted-foreground/60 text-[10px] font-medium tracking-wider uppercase">
                        {t}
                      </span>
                    ))}
                    {related.data.tags.length > 3 && (
                      <span class="text-muted-foreground/60 text-[10px] font-medium tracking-wider uppercase">
                        +{related.data.tags.length - 3}
                      </span>
                    )}
                  </div>
                </a>
              ))}
            </div>
          </div>
        </>
      )
    }
  </main>
</Layout>
