---
import { getCollection, render, getEntries } from "astro:content"
import Layout from "../../layouts/Layout.astro"
import { ExternalLinkIcon } from "lucide-react"
import { cn } from "@/lib/utils"
import { buttonVariants } from "@/components/ui/button"

export async function getStaticPaths() {
  const projects = await getCollection("projects")
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }))
}

const { project } = Astro.props
const { Content } = await render(project)
const hasContent = (project.body ?? "").trim().length > 0
const relatedProjects = project.data.related ? await getEntries(project.data.related) : []
---

<Layout title={project.data.title} description={project.data.description}>
  <div class="wrapper border-border border-b py-3.5">
    <span class="mono-label">projects</span>
  </div>

  <div class="wrapper flex flex-col items-center border-b py-16 md:py-24 lg:py-32">
    <div class="mb-6 flex flex-wrap gap-2">
      {
        project.data.tags.map((tag) => (
          <span class="text-muted-foreground border-border border px-2 py-0.5 font-mono text-[10px] tracking-widest uppercase">
            {tag}
          </span>
        ))
      }
    </div>

    <h1
      class="text-foreground mb-6 text-4xl leading-tight font-semibold tracking-tight md:text-5xl lg:text-6xl"
    >
      {project.data.title}
    </h1>

    <p class="text-muted-foreground mb-10 max-w-2xl text-center text-lg leading-relaxed md:text-xl">
      {project.data.description}
    </p>

    <div class="flex flex-wrap gap-4">
      {
        project.data.links.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class={cn(buttonVariants({ variant: "outlineExpressive" }))}
          >
            <ExternalLinkIcon className="size-3.5" />
            {link.name}
          </a>
        ))
      }
    </div>
  </div>

  {
    hasContent && (
      <div class="wrapper py-12 md:py-16">
        <div class="prose dark:prose-invert prose-pre:bg-muted/50 prose-headings:font-semibold prose-headings:tracking-tight prose-a:text-foreground prose-a:underline prose-a:underline-offset-4 prose-code:font-mono prose-code:text-sm max-w-3xl">
          <Content />
        </div>
      </div>
    )
  }

  {
    relatedProjects.length > 0 && (
      <>
        <div class="wrapper border-b py-3.5">
          <span class="mono-label">related projects</span>
        </div>
        <div class="wrapper grid grid-cols-1 px-0 md:grid-cols-2 [&>*:nth-child(-n+2)]:border-b [&>*:nth-child(odd)]:border-r">
          {relatedProjects.map((related, i) => (
            <a
              href={`/projects/${related.id}`}
              class="group border-border hover:bg-muted/40 flex flex-col gap-4 p-6 transition-colors md:p-8"
            >
              <div class="flex items-center justify-between">
                <span class="mono-label">{related.data.tags[0] ?? "project"}</span>
                <ExternalLinkIcon className="text-muted-foreground group-hover:text-foreground size-4 transition-colors" />
              </div>
              <h3 class="text-foreground decoration-border text-xl font-semibold tracking-tight underline-offset-4 group-hover:underline">
                {related.data.title}
              </h3>
              <p class="text-muted-foreground line-clamp-2 text-sm leading-relaxed">
                {related.data.description}
              </p>
              <div class="mt-auto flex flex-wrap gap-2">
                {related.data.tags.slice(0, 3).map((t) => (
                  <span class="text-muted-foreground border-border border px-2 py-0.5 font-mono text-[10px] tracking-widest uppercase">
                    {t}
                  </span>
                ))}
                {related.data.tags.length > 3 && (
                  <span class="text-muted-foreground font-mono text-[10px] tracking-widest uppercase">
                    +{related.data.tags.length - 3}
                  </span>
                )}
              </div>
            </a>
          ))}
        </div>
      </>
    )
  }
</Layout>
