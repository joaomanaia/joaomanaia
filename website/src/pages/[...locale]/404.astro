---
import Layout from "@/layouts/Layout.astro"
import { Empty, EmptyDescription, EmptyHeader, EmptyTitle } from "@/components/ui/empty"
import { buttonVariants } from "@/components/ui/button"
import { useTranslations, getLocalizedPath, locales, defaultLocale, type Locale } from "@/i18n"

export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))
}

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)
---

<Layout locale={locale} title={t("notFound.title")} description={t("notFound.description")}>
  <div class="flex grow flex-col items-center justify-center">
    <Empty className="my-0 h-fit md:my-24 lg:my-32 xl:my-40">
      <EmptyHeader>
        <EmptyTitle>{t("notFound.title")}</EmptyTitle>
        <EmptyDescription>{t("notFound.description")}</EmptyDescription>
      </EmptyHeader>
      <a href={getLocalizedPath("/", locale)} class={buttonVariants({ variant: "outline" })}>
        {t("notFound.backHome")}
      </a>
    </Empty>
  </div>
</Layout>
