---
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import { ModeToggle } from "./ModeToggle"

const navLinks = [
  { id: "home", href: "/#home", label: "Home" },
  { id: "about", href: "/#about", label: "About" },
  { id: "timeline", href: "/#timeline", label: "Timeline" },
  { id: "projects", href: "/#projects", label: "Projects" },
]
---

<header class="sticky top-0 z-50">
  <nav class="wrapper bg-background flex items-center justify-between border-r border-b border-l">
    <a
      href="/"
      class={cn(
        buttonVariants({ variant: "ghost" }),
        "font-mono text-sm font-semibold tracking-tight transition-opacity hover:bg-transparent hover:text-foreground/80"
      )}
    >
      joaomanaia
    </a>

    <ul class="hidden items-center md:flex">
      {
        navLinks.map(({ id, href, label }) => (
          <li>
            <a
              href={href}
              data-nav-link={id}
              class={cn(
                buttonVariants({ variant: "ghost", size: "lg" }),
                "text-muted-foreground [&.nav-active]:text-foreground relative h-14 rounded-none px-5 font-mono text-sm transition-colors hover:bg-transparent [&.nav-active>div]:scale-x-100"
              )}
            >
              {label}
              <div class="bg-foreground absolute -bottom-px left-0 h-px w-full origin-left scale-x-0 transition-transform duration-300" />
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <ModeToggle client:load />
    </div>
  </nav>
</header>

<script>
  const getNavLinks = () => Array.from(document.querySelectorAll("[data-nav-link]"))

  const updateActiveLink = (links: Element[], id: string | null) => {
    links.forEach((link) => {
      link.classList.toggle("nav-active", link.getAttribute("data-nav-link") === id)
    })
  }

  const handleNavigation = (links: Element[] = getNavLinks()) => {
    const { pathname, hash } = window.location
    if (pathname.startsWith("/projects/")) return updateActiveLink(links, "projects")
    updateActiveLink(links, hash ? hash.slice(1) : pathname === "/" ? "home" : null)
  }

  let observer: IntersectionObserver | null = null

  const init = () => {
    const links = getNavLinks()

    observer?.disconnect()
    observer = new IntersectionObserver(
      (entries) => {
        if (window.location.pathname !== "/") return
        const activeEntry = entries.find((e) => e.isIntersecting)
        if (activeEntry) updateActiveLink(links, activeEntry.target.id)
      },
      { rootMargin: "-50% 0px -50% 0px" }
    )

    handleNavigation(links)
    links.forEach((link) => {
      const id = link.getAttribute("data-nav-link")
      const el = id ? document.getElementById(id) : null
      if (el && observer) observer.observe(el)
    })
  }

  init()
  window.addEventListener("hashchange", () => handleNavigation())
  document.addEventListener("astro:after-navigation", init)
</script>
