---
import { useTranslations, getLocaleFromUrl, type Locale } from "@/i18n"

interface Props {
  locale?: Locale
}

const { locale = getLocaleFromUrl(Astro.url) } = Astro.props
const t = useTranslations(locale)

const stack = [
  { label: t("about.stack.android"), detail: "Kotlin · Jetpack Compose" },
  { label: t("about.stack.frontend"), detail: "React · Astro · TypeScript" },
  { label: t("about.stack.backend"), detail: "Node.js · REST · Supabase" },
  { label: t("about.stack.tooling"), detail: "Git · Docker · CI/CD" },
]
---

<section id="about">
  <div class="wrapper border-border border-b py-3.5">
    <span class="mono-label">{t("about.label")}</span>
  </div>

  <div class="wrapper divide-border grid grid-cols-1 border-b pr-0 md:grid-cols-2 md:divide-x">
    <div class="flex flex-col gap-5 py-12 md:py-16 md:pr-10">
      <h2
        class="text-foreground text-3xl leading-tight font-semibold tracking-tight md:text-4xl"
        set:html={t("about.heading")}
      />
      <div class="text-muted-foreground max-w-md space-y-4 text-base leading-relaxed">
        <p>
          {t("about.bio1")}
        </p>
        <p>
          {t("about.bio2")}
        </p>
      </div>
    </div>

    <div class="grid grow grid-cols-2 [&>*:nth-child(-n+2)]:border-b [&>*:nth-child(odd)]:border-r">
      {
        stack.map(({ label, detail }) => (
          <div class="flex flex-col gap-1.5 p-6">
            <span class="mono-label">{label}</span>
            <span class="text-foreground text-sm leading-snug font-medium">{detail}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
