---
import { ExternalLinkIcon } from "lucide-react"
import { Badge } from "../ui/badge"
import { getCollection } from "astro:content"

const projects = await getCollection("projects")

const orderedProjects = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => {
    const aOrder = a.data.order ?? Number.MAX_SAFE_INTEGER
    const bOrder = b.data.order ?? Number.MAX_SAFE_INTEGER

    if (aOrder !== bOrder) return aOrder - bOrder

    return a.id.localeCompare(b.id)
  })
---

<section id="projects" class="container mx-auto max-w-4xl px-6 py-16 md:py-24 lg:py-32 xl:py-40">
  <h2 class="text-foreground mb-10 font-mono text-3xl font-bold">Projects</h2>
  <div class="space-y-6">
    {
      orderedProjects.map((project) => (
        <a
          href={`/projects/${project.id}`}
          class="group border-border bg-card hover:border-muted-foreground hover:bg-accent block rounded-lg border p-6 transition-all"
        >
          <div class="mb-3 flex items-start justify-between">
            <h3 class="text-card-foreground group-hover:text-accent-foreground font-mono text-xl font-semibold">
              {project.data.title}
            </h3>
            <ExternalLinkIcon className="text-muted-foreground group-hover:text-accent-foreground h-5 w-5 transition-transform group-hover:translate-x-1" />
          </div>
          <p class="text-muted-foreground mb-4 text-sm leading-relaxed">
            {project.data.description}
          </p>
          <div class="flex flex-wrap gap-2">
            {project.data.tech.map((tech) => (
              <Badge
                variant="secondary"
                className="border-border bg-muted text-muted-foreground group-hover:bg-accent-foreground/10 group-hover:text-accent-foreground transition-colors"
                key={tech}
              >
                {tech}
              </Badge>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</section>
