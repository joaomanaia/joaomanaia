---
import { getCollection } from "astro:content"
import { cn } from "@/lib/utils"
import { buttonVariants } from "../ui/button"
import { ExternalLinkIcon } from "lucide-react"
import ProjectCard from "../ProjectCard.astro"
import { filterProjectsByLocale, sortProjects } from "@/lib/content"
import { useTranslations, getLocaleFromUrl, type Locale } from "@/i18n"

interface Props {
  locale?: Locale
}

const { locale = getLocaleFromUrl(Astro.url) } = Astro.props
const t = useTranslations(locale)

const allProjects = await getCollection("projects")
const localeProjects = filterProjectsByLocale(allProjects, locale)
const featured = sortProjects(localeProjects.filter((p) => p.data.featured))
---

<section id="projects">
  <div class="wrapper border-border border-b py-3.5">
    <span class="mono-label">{t("projects.label")}</span>
  </div>

  <div
    class="wrapper border-border flex flex-col gap-6 border-b py-10 md:flex-row md:items-end md:justify-between md:py-14"
  >
    <div>
      <h2 class="text-foreground text-3xl leading-tight font-semibold tracking-tight md:text-4xl">
        {t("projects.heading")}
      </h2>
      <p class="text-muted-foreground mt-3 max-w-md text-base">{t("projects.description")}</p>
    </div>
    <a
      href="https://github.com/joaomanaia?tab=repositories"
      target="_blank"
      rel="noopener noreferrer"
      class={cn(buttonVariants({ variant: "ghost" }))}
      data-umami-event="outbound-link-click"
      data-umami-event-url="https://github.com/joaomanaia?tab=repositories"
    >
      {t("projects.allProjects")}
      <ExternalLinkIcon className="size-3.5" />
    </a>
  </div>

  <div
    class="wrapper grid grid-cols-1 px-0 md:auto-rows-fr md:grid-cols-2 [&>*:nth-child(-n+2)]:border-b [&>*:nth-child(odd)]:border-r"
  >
    {featured.map((project, i) => <ProjectCard project={project} locale={locale} index={i} />)}
  </div>
</section>
