---
import { getCollection } from "astro:content"
import { cn } from "@/lib/utils"
import { buttonVariants } from "../ui/button"
import { ExternalLinkIcon } from "lucide-react"
import ProjectCard from "../ProjectCard.astro"
import { sortProjects } from "@/lib/projects"

const projects = await getCollection("projects")

const featured = sortProjects(projects.filter((p) => p.data.featured))
---

<section id="projects">
  <div class="wrapper border-border border-b py-3.5">
    <span class="mono-label">projects</span>
  </div>

  <div
    class="wrapper border-border flex flex-col gap-6 border-b py-10 md:flex-row md:items-end md:justify-between md:py-14"
  >
    <div>
      <h2 class="text-foreground text-3xl leading-tight font-semibold tracking-tight md:text-4xl">
        Featured Work
      </h2>
      <p class="text-muted-foreground mt-3 max-w-md text-base">Things I've built and shipped.</p>
    </div>
    <a href="/projects" class={cn(buttonVariants({ variant: "ghost" }))}>
      All Projects
      <ExternalLinkIcon className="size-3.5" />
    </a>
  </div>

  <div
    class="wrapper grid grid-cols-1 px-0 md:auto-rows-fr md:grid-cols-2 [&>*:nth-child(-n+2)]:border-b [&>*:nth-child(odd)]:border-r"
  >
    {featured.map((project, i) => <ProjectCard project={project} index={i} />)}
  </div>
</section>
