---
import { Icon } from "astro-icon/components"
import { buttonVariants } from "../ui/button"

const links = [
  { name: "GitHub", url: "https://github.com/joaomanaia", icon: "github" },
  {
    name: "Instagram",
    url: "https://www.instagram.com/_.manaia_/",
    icon: "instagram",
  },
]
---

<section
  id="home"
  class="wrapper flex flex-col items-center border-b py-16 text-center md:py-24 lg:py-32 xl:py-40"
>
  <h1
    class="text-foreground mb-5 text-5xl leading-[1.05] font-semibold tracking-tight md:text-6xl lg:text-7xl"
  >
    João Manaia
  </h1>

  <p class="text-muted-foreground mb-10 max-w-lg text-lg leading-relaxed md:text-xl">
    Building Android apps and web experiences, focused on performance, clean architecture, and
    things that actually work.
  </p>

  <div class="flex flex-wrap items-center gap-4">
    {
      links.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class={buttonVariants({ variant: "outlineExpressive", size: "lg" })}
          data-umami-event="outbound-link-click"
          data-umami-event-url={link.url}
        >
          <Icon name={link.icon} />
          {link.name}
        </a>
      ))
    }
  </div>
</section>
