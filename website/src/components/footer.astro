---
import { ModeToggle } from "@/components/ModeToggle"
import { LanguageToggle } from "./LanguageToggle"
import { useTranslations, getLocaleFromUrl, type Locale } from "@/i18n"

interface Props {
  locale?: Locale
}

const { locale = getLocaleFromUrl(Astro.url) } = Astro.props
const t = useTranslations(locale)
---

<footer class="w-full overflow-x-hidden">
  <div
    class="wrapper flex flex-col-reverse items-center justify-between gap-4 border-t py-8 text-center md:flex-row"
  >
    <p class="text-muted-foreground font-mono text-sm">{t("footer.copyright")}</p>
    <div class="flex items-center gap-2">
      <LanguageToggle client:load currentLocale={locale} />
      <ModeToggle client:load locale={locale} />
    </div>
  </div>
</footer>
