---
const scriptUrl = import.meta.env.UMAMI_SCRIPT_URL || "/orange.js"
const websiteId = import.meta.env.UMAMI_WEBSITE_ID

// Only render if website ID is provided
const isConfigured = websiteId
---

{
  isConfigured ? (
    <script defer src={scriptUrl} data-website-id={websiteId} is:inline type="text/partytown" />
  ) : null
}
